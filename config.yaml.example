regions:
  - eu-frankfurt-1

# Nothing excluded by default. Vaults, keys and certificate authorities can only be
# *scheduled* for deletion - 7 days minimum - and an HSM key version is billed for that wait,
# so excluding them is tempting. Resist it unless the rebuild can adopt them: a nuke that
# also removes the terraform state leaves them orphaned and billed indefinitely, which costs
# more than the week of pending deletion it avoided.
#
# To keep them anyway, add:
#   resource-types:
#     excludes: [OCIVault, OCIKey, OCICertificateAuthority]
# An exclude here always beats an --include on the command line, so comment it out rather
# than trying to override it with a flag.

# Every compartment you intend to nuke must be declared here explicitly - this is a
# safety net, not a discovery mechanism. oci-nuke refuses to run against an
# undeclared compartment.
accounts:
  ocid1.compartment.oc1..exampleaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa: {}
